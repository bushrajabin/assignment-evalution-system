# Server
PORT=5000

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/assignment_evaluation

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# AI Evaluation Provider: "openai", "gemini", or "local" (no external key needed, uses built-in similarity scoring)
AI_PROVIDER=local

# OpenAI (used if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini (used if AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Frontend origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173
